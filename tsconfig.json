// TypeScript-Konfiguration für Custom App, Extension und Build-Werkzeuge.
// Strikte JSON-Dateien wie package.json und manifest.json bleiben bewusst kommentarlos.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    "jsx": "react-jsx",

    "allowJs": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tools/**/*.ts",
    "tools/**/*.mjs"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}